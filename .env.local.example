# Local development uses the shared remote database. Never commit real values.
# PostgreSQL example; MySQL DSNs are also supported.
SQL_DSN=postgresql://yundu_app:replace-with-password@db.example.com:5432/yundu?sslmode=require

# Leave empty to store logs in the primary remote database.
LOG_SQL_DSN=

# Generate a unique value, for example: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-character-secret

